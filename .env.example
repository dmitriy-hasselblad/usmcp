# Public application URL used for authentication redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings - copy this file to .env.local and add your values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Enable only after supabase/schema.sql has been applied successfully.
NEXT_PUBLIC_AUTH_ENABLED=false

# Enable each provider only after it is configured in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_LINKEDIN_AUTH_ENABLED=false

# Transactional email is server-only and disabled by default.
# Preview: set EMAIL_DELIVERY_MODE=test and route every message to EMAIL_TEST_RECIPIENT.
# Production: use live only after the sending domain and recipient flow are verified.
EMAIL_DELIVERY_MODE=disabled
EMAIL_TEST_RECIPIENT=
EMAIL_FROM=USHCE <onboarding@resend.dev>
RESEND_API_KEY=
